#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<EOF
Usage: $(basename "$0") <chat_id> [options]

Options:
  -n, --namespace, --ns <namespace>   tdl namespace
  -s, --size <number>                 export the last N messages (overrides resume)
  -w, --with-content                  include message content in export
  -a, --all                           export all messages, not only media messages
  -r, --raw                           include raw Telegram message structs
      --from-beginning, --no-resume   ignore saved/derived checkpoint and export all matching messages
      --state-dir <dir>               checkpoint directory (default: ./.tdla-state)
  -h, --help                          show this help

Default behavior:
  tdla resumes from the last message it previously downloaded for the chat.
  The checkpoint is saved only after a successful tdl download. If no checkpoint
  exists yet, tdla tries to derive one from existing files in the download dir
  using tdl's default <dialog_id>_<message_id>_<filename> template.
EOF
  exit 1
}

safe_name() {
  printf '%s' "$1" | tr '/:@ ' '____' | tr -cd 'A-Za-z0-9._-'
}

max_message_id_from_export() {
  local file="$1"
  if command -v jq >/dev/null 2>&1; then
    jq -r '[.messages[]?.id] | max // empty' "$file"
  else
    python3 - "$file" <<'PY'
import json, sys
with open(sys.argv[1], 'r', encoding='utf-8') as f:
    data = json.load(f)
ids = [m.get('id') for m in data.get('messages', []) if isinstance(m.get('id'), int)]
print(max(ids) if ids else '')
PY
  fi
}

derive_last_downloaded_id() {
  local dir="$1"
  [[ -d "$dir" ]] || return 0

  # Default tdl template is: {{ .DialogID }}_{{ .MessageID }}_{{ filenamify .FileName }}
  # Extract the second underscore-delimited numeric field and return the max.
  python3 - "$dir" <<'PY'
import os, re, sys
root = sys.argv[1]
max_id = None
pattern = re.compile(r'^[^_]+_(\d+)_')
for base, _, files in os.walk(root):
    for name in files:
        m = pattern.match(name)
        if not m:
            continue
        mid = int(m.group(1))
        max_id = mid if max_id is None or mid > max_id else max_id
print(max_id if max_id is not None else '')
PY
}

if [[ $# -lt 1 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
fi

id="$1"
shift

namespace_option=()
export_range_option=()
with_content_option=()
all_option=()
raw_option=()
resume=1
state_dir=".tdla-state"
size_set=0

while [[ $# -gt 0 ]]; do
  case "$1" in
  --namespace | --ns | -n)
    if [[ -z "${2:-}" || "$2" == -* ]]; then
      echo "Error: --namespace|--ns|-n requires a namespace value" >&2
      usage
    fi
    namespace_option=(-n "$2")
    shift 2
    ;;
  --size | -s)
    if [[ -z "${2:-}" || ! "$2" =~ ^[0-9]+$ ]]; then
      echo "Error: --size|-s requires a numeric value" >&2
      usage
    fi
    export_range_option=(-T last -i "$2")
    size_set=1
    shift 2
    ;;
  --with-content | -w)
    with_content_option=(--with-content)
    shift
    ;;
  --all | -a)
    all_option=(--all)
    shift
    ;;
  --raw | -r)
    raw_option=(--raw)
    shift
    ;;
  --from-beginning | --no-resume)
    resume=0
    shift
    ;;
  --state-dir)
    if [[ -z "${2:-}" || "$2" == -* ]]; then
      echo "Error: --state-dir requires a directory value" >&2
      usage
    fi
    state_dir="$2"
    shift 2
    ;;
  *)
    echo "Unknown option: $1" >&2
    usage
    ;;
  esac
done

chat_file="${id}.json"
download_dir="$id"
state_key="$(safe_name "${namespace_option[*]:-default}__${id}")"
state_file="${state_dir}/${state_key}.last_id"

if [[ "$size_set" -eq 0 && "$resume" -eq 1 ]]; then
  last_id=""
  if [[ -s "$state_file" ]]; then
    last_id="$(tr -cd '0-9' < "$state_file")"
  fi
  if [[ -z "$last_id" ]]; then
    last_id="$(derive_last_downloaded_id "$download_dir")"
  fi

  if [[ -n "$last_id" && "$last_id" =~ ^[0-9]+$ ]]; then
    next_id=$((last_id + 1))
    export_range_option=(-T id -i "${next_id}")
    echo "[tdla] Resuming ${id} from message id ${next_id} (last downloaded: ${last_id})" >&2
  else
    echo "[tdla] No previous checkpoint for ${id}; exporting all matching messages" >&2
  fi
fi

tdl "${namespace_option[@]}" chat export \
  -c "$id" \
  "${export_range_option[@]}" \
  "${with_content_option[@]}" \
  "${all_option[@]}" \
  "${raw_option[@]}" \
  -o "$chat_file"

tdl "${namespace_option[@]}" dl -f "$chat_file" -d "$download_dir" --skip-same

max_id="$(max_message_id_from_export "$chat_file")"
if [[ -n "$max_id" && "$max_id" =~ ^[0-9]+$ ]]; then
  mkdir -p "$state_dir"
  printf '%s\n' "$max_id" > "$state_file"
  echo "[tdla] Checkpoint saved: ${state_file} -> ${max_id}" >&2
else
  echo "[tdla] No exported message IDs found; checkpoint unchanged" >&2
fi
